{
    "name": "@saehrimnir/hagrid",
    "version": "0.3.0",
    "description": "Removes overlaps in scatterplots using space filling curves.",
    "keywords": [
        "scatterplot",
        "overlap-removal",
        "space-filling-curve",
        "hilbert",
        "gosper",
        "visualization"
    ],
    "license": "LGPL-3.0-or-later",
    "homepage": "https://renecutura.eu",
    "author": {
        "name": "Rene Cutura",
        "url": "http://renecutura.eu"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/saehm/hagrid.git"
    },
    "bugs": {
        "url": "https://github.com/saehm/hagrid/issues"
    },
    "type": "module",
    "sideEffects": false,
    "packageManager": "pnpm@11.21.0",
    "main": "./dist/hagrid.cjs",
    "module": "./dist/hagrid.js",
    "browser": "./dist/hagrid.js",
    "types": "./dist/hagrid.d.ts",
    "unpkg": "./dist/hagrid.umd.js",
    "jsdelivr": "./dist/hagrid.umd.js",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/hagrid.d.ts",
                "default": "./dist/hagrid.js"
            },
            "require": {
                "types": "./dist/hagrid.d.cts",
                "default": "./dist/hagrid.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/hagrid.js",
        "dist/hagrid.js.map",
        "dist/hagrid.cjs",
        "dist/hagrid.cjs.map",
        "dist/hagrid.umd.js",
        "dist/hagrid.umd.js.map",
        "dist/hagrid.d.ts",
        "dist/hagrid.d.ts.map",
        "dist/hagrid.d.cts",
        "dist/hagrid.d.cts.map",
        "README.md",
        "LICENCE",
        "THIRD-PARTY.md"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "dev": "rollup --config --watch",
        "build": "rollup --config",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "docs:dev": "pnpm run build && pnpm --filter @saehrimnir/hagrid-docs dev",
        "docs:build": "pnpm run build && pnpm --filter @saehrimnir/hagrid-docs build",
        "docs:preview": "pnpm --filter @saehrimnir/hagrid-docs preview",
        "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
    },
    "devDependencies": {
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-replace": "^6.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@types/d3-delaunay": "^6.0.4",
        "@vitest/coverage-v8": "^4.1.10",
        "rollup": "^4.62.4",
        "rollup-plugin-dts": "^6.5.1",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "d3-delaunay": "^6.0.4"
    }
}
