{
    "name": "@saehrimnir/hagrid",
    "version": "0.3.0",
    "description": "Removes overlaps in scatterplots using space filling curves.",
    "keywords": [
        "scatterplot",
        "overlap-removal",
        "space-filling-curve",
        "hilbert",
        "gosper",
        "visualization"
    ],
    "license": "MIT",
    "homepage": "https://renecutura.eu",
    "author": {
        "name": "Rene Cutura",
        "url": "http://renecutura.eu"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/saehm/hagrid.git"
    },
    "bugs": {
        "url": "https://github.com/saehm/hagrid/issues"
    },
    "type": "module",
    "sideEffects": false,
    "main": "dist/hagrid.cjs",
    "module": "dist/hagrid.js",
    "types": "dist/hagrid.d.ts",
    "unpkg": "dist/hagrid.min.js",
    "jsdelivr": "dist/hagrid.min.js",
    "exports": {
        ".": {
            "types": "./dist/hagrid.d.ts",
            "import": "./dist/hagrid.js",
            "require": "./dist/hagrid.cjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/",
        "README.md"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "dev": "rollup --config --watch",
        "build": "rollup --config",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
    },
    "devDependencies": {
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-replace": "^6.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@types/d3-delaunay": "^6.0.4",
        "rollup": "^4.62.4",
        "rollup-plugin-dts": "^6.5.1",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "d3-delaunay": "^6.0.4"
    }
}
